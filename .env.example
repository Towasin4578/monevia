# Monevia Environment Variables Template
# Monevia is 100% functional locally with IndexedDB fallback if these are omitted.

# Supabase Integration (Optional - for cloud multi-device sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Exchange Rate API (Optional - baseline offline table provides instant rates for 150+ currencies)
VITE_EXCHANGE_RATE_API_KEY=
